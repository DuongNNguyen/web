@model List<Product>
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<div class="section-heading"><h1>Sản phẩm</h1><a asp-action="Create" class="btn btn-primary">＋ Thêm sản phẩm</a></div>
<form method="get" class="panel actions mb-4"><input name="keyword" value="@Context.Request.Query["keyword"]" class="form-control" placeholder="Tìm tên sản phẩm..." aria-label="Tìm sản phẩm" /><select name="brandId" class="form-select" aria-label="Thương hiệu"><option value="">Tất cả thương hiệu</option>@foreach(Brand brand in ViewBag.Brands){<option value="@brand.BrandId" selected="@(Context.Request.Query["brandId"] == brand.BrandId.ToString())">@brand.BrandName</option>}</select><select name="active" class="form-select" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="true" selected="@(Context.Request.Query["active"] == "true")">Hoạt động</option><option value="false" selected="@(Context.Request.Query["active"] == "false")">Tạm ẩn</option></select><button class="btn btn-primary">Lọc</button></form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Sản phẩm</th><th>Thương hiệu</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var p in Model){<tr><td><div class="actions"><img class="table-image" src="@p.MainImageUrl" alt="" /><a asp-action="Details" asp-route-id="@p.ProductId">@p.ProductName</a></div></td><td>@p.Brand.BrandName</td><td>@StoreHelper.Money(p.SellingPrice)</td><td>@p.StockQuantity</td><td>@(p.IsActive ? "Hoạt động" : "Tạm ẩn")</td><td><div class="actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.ProductId">Sửa</a><form asp-action="Toggle" method="post"><input name="id" type="hidden" value="@p.ProductId" /><button class="btn btn-sm btn-outline-secondary">@(p.IsActive ? "Ẩn" : "Hiện")</button></form></div></td></tr>}</tbody></table>@if(Model.Count == 0){<p class="empty">Không có sản phẩm phù hợp.</p>}</div><partial name="_Pagination" />
