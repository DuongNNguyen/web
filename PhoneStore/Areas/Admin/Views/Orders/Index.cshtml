@model List<Order>
@{ ViewData["Title"] = "Quản lý đơn hàng"; }
<h1>@ViewData["Title"]</h1>
<form method="get" class="panel actions mb-4"><input name="keyword" value="@Context.Request.Query["keyword"]" class="form-control" placeholder="Mã đơn, khách hàng, người nhận..." aria-label="Tìm đơn hàng" /><select name="status" class="form-select" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option>@foreach(var status in Enum.GetValues<OrderStatus>()){<option value="@status" selected="@(Context.Request.Query["status"] == status.ToString())">@StoreHelper.Status(status)</option>}</select><select name="sort" class="form-select" aria-label="Sắp xếp"><option value="newest">Mới nhất</option><option value="oldest" selected="@(Context.Request.Query["sort"] == "oldest")">Cũ nhất</option></select><button class="btn btn-primary">Tìm kiếm</button></form>
<div class="panel table-responsive"><table class="table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Người nhận</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var order in Model){<tr><td class="order-code">@order.OrderCode</td><td>@StoreHelper.Date(order.OrderDate)</td><td>@order.ReceiverName</td><td>@StoreHelper.Money(order.TotalAmount)</td><td><span class="status-pill status-@order.Status">@StoreHelper.Status(order.Status)</span></td><td><a asp-action="Details" asp-route-id="@order.OrderId">Chi tiết →</a></td></tr>}
</tbody></table>@if(Model.Count == 0){<div class="empty"><h2>Chưa có đơn hàng</h2><p>Không có đơn hàng phù hợp với bộ lọc.</p></div>}</div><partial name="_Pagination" />
