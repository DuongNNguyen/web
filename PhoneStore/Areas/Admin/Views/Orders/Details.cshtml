@model Order
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<div class="section-heading"><div><span class="eyebrow">CHI TIẾT ĐƠN HÀNG</span><h1 class="order-code">@Model.OrderCode</h1></div><span class="status-pill status-@Model.Status">@StoreHelper.Status(Model.Status)</span></div>
<p>Khách hàng: @Model.User.FullName · @Model.User.Email</p>
<partial name="_OrderSummary" model="Model" /><div class="actions mt-4"><a asp-action="Index" class="btn btn-light">← Danh sách đơn hàng</a>
@foreach(var next in Enum.GetValues<OrderStatus>().Where(s => OrderService.CanTransition(Model.Status, s))){<form asp-action="UpdateStatus" method="post" data-confirm="Cập nhật trạng thái đơn hàng?"><input name="id" type="hidden" value="@Model.OrderId" /><input name="status" type="hidden" value="@next" /><button class="btn @(next == OrderStatus.Cancelled ? "btn-outline-danger" : "btn-primary")">@StoreHelper.Status(next)</button></form>}
</div>
