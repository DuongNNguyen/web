@model List<Brand>
@{ ViewData["Title"] = "Thương hiệu"; }
<div class="section-heading"><h1>@ViewData["Title"]</h1><a class="btn btn-primary" asp-action="Create">Thêm mới</a></div>
<div class="panel table-responsive"><table class="table"><thead><tr><th>Tên</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var item in Model) {
<tr><td>@item.BrandName</td><td>@item.Description</td><td>@(item.IsActive ? "Hoạt động" : "Tạm ẩn")</td><td><div class="actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.BrandId">Sửa</a><form asp-action="Toggle" method="post"><input name="id" type="hidden" value="@item.BrandId" /><button class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Tạm ẩn" : "Kích hoạt")</button></form></div></td></tr>
}
</tbody></table>@if(Model.Count == 0){<p class="empty">Chưa có dữ liệu.</p>}</div>
