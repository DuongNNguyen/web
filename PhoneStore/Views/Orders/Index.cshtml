@model List<Order>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<h1>@ViewData["Title"]</h1>

<div class="panel table-responsive"><table class="table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var order in Model){<tr><td class="order-code">@order.OrderCode</td><td>@StoreHelper.Date(order.OrderDate)</td><td>@StoreHelper.Money(order.TotalAmount)</td><td><span class="status-pill status-@order.Status">@StoreHelper.Status(order.Status)</span></td><td><a asp-action="Details" asp-route-id="@order.OrderId">Chi tiết →</a></td></tr>}
</tbody></table>@if(Model.Count == 0){<div class="empty"><h2>Chưa có đơn hàng</h2><p>Đơn hàng của bạn sẽ được hiển thị tại đây.</p><a href="/Products" class="btn btn-primary">Mua sắm ngay</a></div>}</div><partial name="_Pagination" />
